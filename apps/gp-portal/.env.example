# Copy to .env.local for local development (Next.js convention — never .env, which
# this app doesn't use). Never commit a real .env.local — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".
#
# Every var here is NEXT_PUBLIC_* (inlined at build time — never put a secret behind
# this prefix, per CONVENTIONS.md). docker-compose.yml's gp-portal service currently
# only sets NEXT_PUBLIC_IDENTITY_ACCESS_URL / NEXT_PUBLIC_REFERRAL_SERVICE_URL /
# NEXT_PUBLIC_KEYCLOAK_ISSUER — editing that root file is outside this app's scope
# (see lib/api/config.ts), so every URL below has a hardcoded localhost fallback
# matching root CONVENTIONS.md §1's port table. Only set what your local setup
# actually differs on.

NEXT_PUBLIC_APP_BASE_URL="http://localhost:3100"

# Keycloak — gp-portal is a PUBLIC client (Authorization Code + PKCE, no client
# secret), per infra/keycloak/realm-export.json. Passkey/hardware-key sign-in is
# mandatory for this client's bound "clinician-browser" auth flow.
NEXT_PUBLIC_KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID="gp-portal"

NEXT_PUBLIC_IDENTITY_ACCESS_URL="http://localhost:3001"
NEXT_PUBLIC_ONBOARDING_ACCOUNT_URL="http://localhost:3002"
NEXT_PUBLIC_GP_AUTHORISATION_URL="http://localhost:3003"
NEXT_PUBLIC_CONSENT_SECURITY_URL="http://localhost:3004"
NEXT_PUBLIC_REFERRAL_SERVICE_URL="http://localhost:3005"
NEXT_PUBLIC_DIRECTORY_SERVICE_URL="http://localhost:3006"
NEXT_PUBLIC_FOLLOWUP_RECALL_URL="http://localhost:3009"
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL="http://localhost:3010"

# Expo reads env vars prefixed EXPO_PUBLIC_ at build time and inlines them into the
# JS bundle — never put a secret behind this prefix. See root CONVENTIONS.md.
EXPO_PUBLIC_ONBOARDING_ACCOUNT_SERVICE_URL="http://localhost:3002"
EXPO_PUBLIC_IDENTITY_ACCESS_URL="http://localhost:3001"
EXPO_PUBLIC_GP_AUTHORISATION_URL="http://localhost:3003"
EXPO_PUBLIC_CONSENT_SECURITY_URL="http://localhost:3004"
EXPO_PUBLIC_REFERRAL_SERVICE_URL="http://localhost:3005"
EXPO_PUBLIC_DIRECTORY_SERVICE_URL="http://localhost:3006"
EXPO_PUBLIC_BOOKING_SERVICE_URL="http://localhost:3007"
EXPO_PUBLIC_NOTIFICATION_SERVICE_URL="http://localhost:3010"

# Keycloak — patient-mobile is a PUBLIC client (Authorization Code + PKCE via
# expo-auth-session), bound to the "patient-carer-browser" auth flow: passkey
# offered as an ALTERNATIVE to password+conditional-OTP. KNOWN GAP: no Keycloak
# user is provisioned for a patient/carer anywhere in this build yet — see
# BUILD_LOG/patient-app.md.
EXPO_PUBLIC_KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID="patient-mobile"

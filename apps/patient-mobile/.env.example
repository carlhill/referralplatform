# Expo reads env vars prefixed EXPO_PUBLIC_ at build time and inlines them into the
# JS bundle — never put a secret behind this prefix. See root CONVENTIONS.md.
EXPO_PUBLIC_ONBOARDING_ACCOUNT_SERVICE_URL="http://localhost:3002"
EXPO_PUBLIC_REFERRAL_SERVICE_URL="http://localhost:3005"
EXPO_PUBLIC_KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID="patient-mobile"

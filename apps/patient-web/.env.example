# Copy to .env.local for local development (Next.js convention). Never commit a
# real .env.local — see root .gitignore. Full convention: root CONVENTIONS.md,
# "Environment variable conventions".
#
# Every var here is NEXT_PUBLIC_* (inlined at build time — never put a secret behind
# this prefix). docker-compose.yml does not yet wire every var this app needs into
# the `patient-web` service's `environment:` block — editing that root file is
# outside this app's scope (see lib/api/config.ts) — so every URL below has a
# hardcoded localhost fallback matching root CONVENTIONS.md §1's port table.

NEXT_PUBLIC_APP_BASE_URL="http://localhost:3102"

# Keycloak — patient-web is a PUBLIC client (Authorization Code + PKCE, no client
# secret), bound to the "patient-carer-browser" auth flow: passkey offered as an
# ALTERNATIVE to password+conditional-OTP (encouraged, not mandatory) — see
# infra/keycloak/README.md. KNOWN GAP: no Keycloak user is provisioned for a
# patient/carer anywhere in this build yet — see BUILD_LOG/patient-app.md.
NEXT_PUBLIC_KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID="patient-web"

NEXT_PUBLIC_IDENTITY_ACCESS_URL="http://localhost:3001"
NEXT_PUBLIC_ONBOARDING_ACCOUNT_URL="http://localhost:3002"
NEXT_PUBLIC_GP_AUTHORISATION_URL="http://localhost:3003"
NEXT_PUBLIC_CONSENT_SECURITY_URL="http://localhost:3004"
NEXT_PUBLIC_REFERRAL_SERVICE_URL="http://localhost:3005"
NEXT_PUBLIC_DIRECTORY_SERVICE_URL="http://localhost:3006"
NEXT_PUBLIC_BOOKING_SERVICE_URL="http://localhost:3007"
NEXT_PUBLIC_FOLLOWUP_RECALL_URL="http://localhost:3009"
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL="http://localhost:3010"

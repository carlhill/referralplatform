  "authenticationFlows": [
    {
      "id": "b6f10000-0000-4000-8000-0000000000b1",
      "alias": "patient-carer-browser",
      "description": "Browser login for patient/carer principals \u2014 passkey (WebAuthn passwordless) encouraged, password+OTP fallback acceptable (AAL1/AAL2). See identity-security-recommendations.md section 6 and modules-and-requirements.md ('Identity & Access').",

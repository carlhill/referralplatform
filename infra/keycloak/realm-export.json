      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "autheticatorFlow": true,
          "flowAlias": "patient-carer-browser Forms"
        }
      ]
    },
    {
      "alias": "patient-carer-browser Forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "patient-carer-browser Credential"
        }
      ]
    },
    {
      "alias": "patient-carer-browser Credential",
      "description": "Either a passwordless passkey (preferred) or password+conditional-OTP (fallback) \u2014 offered as alternatives, not stacked, matching how passkey login actually works (it replaces the password step, not adds to it).",

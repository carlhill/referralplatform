  "clientScopes": [
    {
      "name": "backend-services-audience",
      "description": "Adds every backend service's client id to the aud claim so frontend-issued user tokens can be validated by any backend service they call.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "admin-console-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {

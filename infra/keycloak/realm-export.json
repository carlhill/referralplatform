      },
      {
        "name": "carer_authorised_representative",
        "description": "Authorised representative \u2014 high-friction, evidence-based carer tier."
      },
      {
        "name": "gp",
        "description": "GP / practice staff. Passkey or hardware key expected (AAL2/AAL3)."
      },
      {
        "name": "specialist",
        "description": "Specialist / practice staff. Passkey or hardware key expected (AAL2/AAL3)."
      },
      {

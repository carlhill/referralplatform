{
  "name": "referralplatform",
  "private": true,
  "version": "0.1.0",
  "description": "ReferralPlatform monorepo root. See CONVENTIONS.md before adding anything here.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "services/*",
    "apps/*",
    "packages/*",
    "integration"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:realm": "node infra/keycloak/validate-realm-export.mjs",
    "validate:outbox": "node infra/validate-outbox-schemas.mjs",
    "validate": "npm run validate:realm && npm run validate:outbox",
    "test:integration": "npm run test:integration -w integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
}

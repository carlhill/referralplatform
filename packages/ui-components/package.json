{
  "name": "@referralplatform/ui-components",
  "version": "0.1.0",
  "description": "ReferralPlatform design system — Button, Card, Pill/StatusBadge, FormField, built on Radix UI primitives per claude/ui-design.md (palette, typography, 8px spacing scale).",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/tokens.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-css",
    "copy-css": "mkdir -p dist && cp src/tokens.css dist/tokens.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "lucide-react": "^1.31.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.6.3"
  }
}

# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3011
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=admin_console"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="admin-console-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# Onboarding & Account Service — the verification-cases module snapshots
# live AHPRA/HPI-O verification status from here (GET /specialists/:id,
# GET /gp-practices/:id) rather than owning that data itself. See
# src/common/onboarding-account.client.ts.
ONBOARDING_ACCOUNT_SERVICE_URL="http://localhost:3002"

# Consent & Security Service — the deceased-access-requests module proxies
# its own real executor/family/coroner access-request queue rather than
# duplicating it. See src/common/consent-security.client.ts.
CONSENT_SECURITY_SERVICE_URL="http://localhost:3004"

# Step-up authentication (see src/common/step-up.ts): the `acr` claim value
# Keycloak is expected to issue after a fresh passkey/hardware-key re-auth.
# Gates POST /verification-cases/:id/approve and
# POST /verification-cases/:id/reject (root CONVENTIONS.md §8 names
# "approving a new GP link" / "granting deceased-patient access" as the
# worked examples this mirrors for this console's own decision actions).
# consent-security enforces its own STEP_UP_ACR check independently for
# access-request approvals proxied through this console.
STEP_UP_ACR="passkey"

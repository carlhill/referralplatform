# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3012
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=audit_log"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="audit-log-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# This IS the Audit Log Service — AUDIT_LOG_SERVICE_URL is not applicable here
# (other services set that env var pointing back at this service's PORT above).

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# immudb — the tamper-evident ledger this service is built around; see
# claude/audit-log-architecture-decision.md. Postgres (DATABASE_URL above) is
# used only for relational metadata (e.g. verification-request bookkeeping),
# never for the audit entries themselves.
IMMUDB_ADDRESS="immudb:3322"
IMMUDB_USERNAME="immudb"
IMMUDB_PASSWORD="change-me-in-local-env"
IMMUDB_DATABASE="audit_log"

# NASH signing — HSM-backed in production (AWS KMS/CloudHSM per
# claude/solution-architecture-tech-stack.md); a local dev keypair path is
# fine for MVP-stage local dev only, never commit real key material.
# MOCK implementation — see src/signing/mock-nash.signer.ts.
NASH_SIGNING_KEY_PATH="./local-dev-only-nash-key.pem"

# Crypto-shredding per-user data keys — real KMS/HSM (AWS KMS/CloudHSM) in
# production per claude/solution-architecture-tech-stack.md. This path is a
# local JSON keystore used only by the MOCK implementation — see
# src/crypto-shredding/mock-local.kms.ts. Never commit a real keystore file.
KMS_MOCK_KEYSTORE_PATH="./local-dev-only-kms-keystore.json"

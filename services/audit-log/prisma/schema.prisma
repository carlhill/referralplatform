// Prisma schema for the audit-log service.
//
// Convention (see root CONVENTIONS.md, "Database access / ORM"): one shared
// Postgres instance, one schema per service. This service's schema is
// "audit_log" — set via the `?schema=audit_log` query param on DATABASE_URL
// (see .env.example), not hardcoded here, so the same schema.prisma works in
// every environment.
//
// First model in this service? Run:
//   npx prisma migrate dev --name init
// which creates prisma/migrations/ (commit it) and generates the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Relational metadata only — never the audit entries themselves (those live in
// immudb; see claude/audit-log-architecture-decision.md and .env.example's
// IMMUDB_* comment). This index exists because immudb is a verifiable
// key/value store: it can prove a single key's history hasn't been tampered
// with, but it has no secondary-index query engine of its own. So this table
// is what lets the query API answer "every event for Referral X" without
// scanning all of immudb — the source of truth for content + tamper-evidence
// is always immudb, this table just points at it.
model AuditEventIndex {
  /// Same id as the AuditEvent (shared-types) / the immudb key suffix.
  id                 String   @id
  type               String
  actorPrincipalType String
  actorId            String
  subjectType        String
  subjectId          String
  occurredAt         DateTime
  /// immudb key this event's envelope was written under (see ImmudbService).
  immudbKey          String
  /// immudb transaction id returned by verifiedSet — proof anchor for verify().
  immudbTxId         String
  /// Which NASH (mock) signing key signed this entry — lets verify() find the right public key.
  nashKeyId          String
  createdAt          DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([type])
  @@map("audit_event_index")
}

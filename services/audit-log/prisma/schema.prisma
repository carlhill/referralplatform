// Prisma schema for the audit-log service.
//
// Convention (see root CONVENTIONS.md, "Database access / ORM"): one shared
// Postgres instance, one schema per service. This service's schema is
// "audit_log" — set via the `?schema=audit_log` query param on DATABASE_URL
// (see .env.example), not hardcoded here, so the same schema.prisma works in
// every environment.
//
// First model in this service? Run:
//   npx prisma migrate dev --name init
// which creates prisma/migrations/ (commit it) and generates the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


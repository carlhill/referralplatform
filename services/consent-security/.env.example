# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3004
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=consent_security"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="consent-security-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# GP Authorisation Service — src/linked-gps proxies "linked GPs and
# practices" list/revoke calls here rather than owning GPLink data itself
# (see root CONVENTIONS.md §6: a service never reads another service's
# schema directly).
GP_AUTHORISATION_SERVICE_URL="http://localhost:3003"

# Step-up authentication (see src/common/step-up.ts): the `acr` claim value
# Keycloak is expected to issue after a fresh passkey/hardware-key re-auth.
# Gates POST /access-requests/:id/approve — root CONVENTIONS.md §8 names
# "granting deceased-patient access" as a worked example of a step-up-gated
# action. The realm doesn't yet have the Conditional-OTP/ACR-to-LoA flow
# that actually emits this claim — see infra/keycloak/README.md.
STEP_UP_ACR="passkey"

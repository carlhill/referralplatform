# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3006
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=directory"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="directory-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# --- Directory Service ---
# Comma-separated PHN region codes the MOCK HealthPathways client treats as
# not-yet-licensed for inline guidance, to exercise the graceful-degradation
# path — see src/directory/healthpathways/mock-healthpathways-client.ts.
HEALTHPATHWAYS_UNAVAILABLE_PHNS=""

# --- Secure Messaging Gateway ---
# Vendor to use when a DirectoryEntry doesn't specify its own secureMessagingVendor.
SECURE_MESSAGING_DEFAULT_VENDOR="healthlink"
# 0..1 — MOCK vendor clients' random simulated failure rate (in addition to the
# deterministic "FAIL" substring trigger in recipientEndpointId) — see src/secure-messaging/vendors.
HEALTHLINK_MOCK_FAILURE_RATE="0"
MEDICAL_OBJECTS_MOCK_FAILURE_RATE="0"
DIRECT_DELIVERY_MOCK_FAILURE_RATE="0"
# Notification Service base URL — used for the dual-notification exception call
# on a delivery failure (services/notification, out of this build's scope; this
# call is best-effort and never blocks/masks the real delivery-failure exception).
NOTIFICATION_SERVICE_URL="http://localhost:3010"

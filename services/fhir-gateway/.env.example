# Copy to .env (or export directly) for local development.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".
# Spring reads these as environment variables directly (see application.yml).

PORT=3013

# Healthcare Identifiers Service (IHI/HPI-O/HPI-I lookups)
HI_SERVICE_BASE_URL=https://hi-service.example.gov.au

# NASH signing key — HSM-backed in production; local dev key only, never commit real key material.
NASH_SIGNING_KEY_PATH=./local-dev-only-nash-key.pem

# My Health Record conformance endpoint
MHR_BASE_URL=https://mhr.example.gov.au

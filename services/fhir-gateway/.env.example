# Copy to .env (or export directly) for local development.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".
# Spring reads these as environment variables directly (see application.yml).

PORT=3013

# Healthcare Identifiers Service (IHI/HPI-O/HPI-I lookups) — MOCK in this build,
# no real government B2B/NASH credentials exist. HI_SERVICE_MODE=block (default)
# fails every lookup with a clear error rather than proceeding unverified;
# HI_SERVICE_MODE=fixture returns a small static fake identifier set for local
# dev/testing of downstream happy-path logic only. See
# src/main/java/.../hiservice/MockHealthcareIdentifiersService.java.
HI_SERVICE_BASE_URL=https://hi-service.example.gov.au
HI_SERVICE_MODE=block

# NASH signing key — HSM-backed in production; local dev key only, never commit real key material.
# Same block/fixture mode semantics as above — see nash/MockNashSigningService.java.
NASH_SIGNING_KEY_PATH=./local-dev-only-nash-key.pem
NASH_MODE=block

# My Health Record conformance endpoint — mocked, same block/fixture semantics.
# See mhr/MockMyHealthRecordService.java.
MHR_BASE_URL=https://mhr.example.gov.au
MHR_MODE=block

# Service-to-service auth (root CONVENTIONS.md §8) for calling the Audit Log
# Service — see BUILD_LOG/fhir-gateway.md, "Known gaps outside this service's
# scope" for why `fhir-gateway-service` is not yet a registered Keycloak
# client and these are not yet wired into docker-compose.yml.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/referralplatform
KEYCLOAK_CLIENT_ID=fhir-gateway-service
KEYCLOAK_CLIENT_SECRET=change-me-in-local-env
AUDIT_LOG_SERVICE_URL=http://audit-log:3012
# Set to false only for local/test runs that must not attempt any network call.
FHIR_GATEWAY_AUDIT_ENABLED=true

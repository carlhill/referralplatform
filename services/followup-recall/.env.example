# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3009
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=followup_recall"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="followup-recall-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# Consent & Security Service — src/deceased-suppression polls
# GET /events?type=patient.deceased.frozen against this service (the
# interim stand-in for a real SQS/SNS push, per BUILD_LOG/consent-security.md
# "Interim polling pattern") and does a live GET /deceased-flags/:patientId
# last-mile check before actually sending any reminder. See
# BUILD_LOG/followup-recall.md.
CONSENT_SECURITY_SERVICE_URL="http://localhost:3004"

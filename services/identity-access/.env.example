# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3001
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=identity_access"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="identity-access-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# Account-linking (see src/account-links): the frontend origins the
# /account/social-links/:provider/link-url endpoint is allowed to redirect
# back to, comma-separated — an open-redirect guard, not a CORS setting.
ACCOUNT_LINK_ALLOWED_ORIGINS="http://localhost:3100,http://localhost:3101,http://localhost:3102,http://localhost:8081"

# Step-up authentication (see src/common/step-up): the `acr` claim value
# Keycloak is expected to issue after a fresh passkey/hardware-key re-auth.
# The realm doesn't yet have the Conditional-OTP/ACR-to-LoA flow that actually
# emits this — see infra/keycloak/README.md, "Step-up authentication".
STEP_UP_ACR="passkey"

# MOCK myID (TDIF) relying-party stub (see src/mock-myid) — Keycloak's `myid`
# identity provider (infra/keycloak/realm-export.json) is configured against
# these same values in local dev. Replace with the real myID/TDIF-accredited
# IdP's issuer + this service's real registered client credentials when
# integrating for real; nothing about the Keycloak-side wiring changes shape.
MOCK_MYID_CLIENT_ID="referralplatform-myid-stub"
MOCK_MYID_CLIENT_SECRET="change-me-in-local-env"
MOCK_MYID_ISSUER_BASE_URL="http://localhost:3001/mock-myid"

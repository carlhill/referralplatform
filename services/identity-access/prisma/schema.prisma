// Prisma schema for the identity-access service.
//
// Convention (see root CONVENTIONS.md, "Database access / ORM"): one shared
// Postgres instance, one schema per service. This service's schema is
// "identity_access" — set via the `?schema=identity_access` query param on DATABASE_URL
// (see .env.example), not hardcoded here, so the same schema.prisma works in
// every environment.
//
// First model in this service? Run:
//   npx prisma migrate dev --name init
// which creates prisma/migrations/ (commit it) and generates the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single-use nonce issued when an already-authenticated principal (patient,
/// carer, GP, specialist, or internal staff — see AuthenticatedPrincipal in
/// packages/auth-client) requests to link a secondary Google/Microsoft
/// sign-in method to their existing, already identity-verified account.
///
/// This row is what lets `POST /account/social-links/:provider/link-url`
/// (see src/account-links) be genuinely safe: the nonce/hash pair it produces
/// is consumed by Keycloak's "Client Initiated Account Linking" broker
/// endpoint (`GET /realms/{realm}/broker/{provider}/link`), which Keycloak
/// only honours for a provider configured with `linkOnly: true` (see
/// infra/keycloak/realm-export.json) — i.e. this mechanism can only ever
/// attach a social identity to an account that already exists and is already
/// logged in; it can never create or activate one. See
/// claude/solution-architecture-tech-stack.md ("Identity and access") and
/// claude/modules-and-requirements.md ("Identity & Access") for why this
/// constraint is load-bearing, not incidental.
model AccountLinkRequest {
  id            String    @id @default(uuid())
  /// The Keycloak subject id (AuthenticatedPrincipal.sub) of the caller who
  /// requested the link — always populated from a verified bearer token,
  /// never from client-supplied input.
  principalId   String
  principalType String
  /// 'google' | 'microsoft' — enforced at the application layer against the
  /// allow-list in src/account-links/account-links.service.ts; 'myid' and any
  /// internal service alias are rejected before a row is ever created.
  provider      String
  nonce         String    @unique
  /// The Keycloak SSO session id (the `sid` claim of the caller's ID token,
  /// supplied by the frontend — see account-links.service.ts for why this
  /// service cannot derive it itself from an access token alone).
  sessionId     String
  createdAt     DateTime  @default(now())
  /// Short TTL (see account-links.service.ts) — a stale, unconsumed link
  /// request must not remain usable.
  expiresAt     DateTime
  consumedAt    DateTime?

  @@index([principalId])
  @@index([expiresAt])
}

/// Durable queue for this service's IAM audit events (root CONVENTIONS.md §7).
///
/// These were previously written with direct `AuditClient.record()` calls, on the
/// documented reasoning that IAM events have no clinical transaction to stay atomic
/// with. That reasoning holds — but durability was the unexamined half: a direct
/// write that fails is simply gone. That happened for real (every `identity.*` type
/// was missing from the Audit Log Service's whitelist, so every write 400'd and was
/// discarded), which meant passkey revocations — exactly what an incident review
/// needs — were never recorded. Queuing here instead means an Audit Log Service
/// outage or a validation change delays events rather than destroying them.
model AuditOutbox {
  id          String    @id @default(uuid())
  type        String
  actor       Json
  subjectType String
  subjectId   String
  payload     Json
  occurredAt  DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  /// When this row next becomes eligible for a relay attempt (exponential backoff).
  /// NULL means "eligible now" - the state every freshly-enqueued row starts in.
  nextAttemptAt DateTime?

  @@index([publishedAt])
  @@index([nextAttemptAt])
  @@map("audit_outbox")
}

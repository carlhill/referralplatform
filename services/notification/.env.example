# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3010
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=notification"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="notification-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# --- Notification channels (root CONVENTIONS.md §10, modules-and-requirements.md) ---

# SMTP — REAL email delivery. In local dev this is Mailhog (docker-compose.yml's
# "mailhog" service); view sent mail at http://localhost:8025. Swap for a real
# transactional-email provider's SMTP endpoint in a real environment.
SMTP_HOST="localhost"
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM="no-reply@referralplatform.example.au"

# SMS provider — MOCK for this build (no paid SMS account exists). Wired
# against the same SmsProvider interface (src/notifications/providers/sms-provider.ts)
# so swapping in a real vendor (Twilio, MessageMedia, ...) is a provider-class
# swap, not a redesign.
SMS_PROVIDER="mock"

# Push provider — MOCK for this build (no FCM/APNs credentials exist). Wired
# against PushProvider (src/notifications/providers/push-provider.ts).
PUSH_PROVIDER="mock"

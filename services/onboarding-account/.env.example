# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3002
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=onboarding_account"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="onboarding-account-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# --- Onboarding & Account service-specific config -------------------------

# SMTP (Mailhog in local/dev/CI — see docker-compose.yml "mailhog" service).
# Every onboarding email (the activation link AND the 6-digit OTP) goes
# through this — see modules-and-requirements.md for why this build uses
# email end to end instead of SMS (no paid SMS provider account exists).
# View sent mail at http://localhost:8025.
SMTP_HOST="localhost"
SMTP_PORT=1025
# SMTP_USER / SMTP_PASSWORD — leave unset for Mailhog (no auth). Set both
# when pointing this at a real transactional-email provider.
EMAIL_FROM="no-reply@referralplatform.example.au"

# HMAC key for OTP code hashing (src/common/otp/otp.util.ts) — a real secret
# in every real environment (see infra/terraform/secrets/main.tf); this
# placeholder is fine for local dev only.
OTP_HASH_SECRET="change-me-in-local-env"

# The frontend URL the activation-link email points at — see
# apps/patient-web (or patient-mobile's deep link, once wired).
ACTIVATION_LINK_BASE_URL="http://localhost:3102/activate"

# Directory Service — for POST /specialists' directory-profile-creation step
# (src/directory-client). See that client's doc comment: services/directory
# does not have a receiving endpoint yet in this build, so this call
# degrades gracefully to directoryProfileStatus="pending_directory_service"
# rather than failing specialist onboarding.
DIRECTORY_SERVICE_URL="http://localhost:3006"

# Identity & Access Service — for the post-activation passkey-enrolment
# prompt (src/identity-access-client). See that client's doc comment for the
# documented cross-service gap (the real target endpoint doesn't exist yet).
IDENTITY_ACCESS_SERVICE_URL="http://localhost:3001"

# --- Tunables (all optional — sensible defaults are baked into the code,
# these are here so an operator can override without a redeploy) ----------
ACTIVATION_LINK_TTL_HOURS=48
QUEUE_TTL_HOURS=48
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=30
OTP_RESEND_MAX_PER_HOUR=5
IDENTITY_VERIFY_MAX_ATTEMPTS=5
IDENTITY_VERIFY_LOCKOUT_MINUTES=30
ACCOUNT_REQUEST_MAX_PER_GP_PER_HOUR=20
ACCOUNT_REQUEST_MAX_PER_MOBILE_PER_DAY=3
REATTESTATION_INTERVAL_DAYS=365
ORG_CARER_THRESHOLD=3

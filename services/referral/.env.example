# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3005
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=referral"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="referral-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# GP Authorisation Service — GpAuthorisationClient calls GET /gp-links/authorisation
# here before creating a referral for a not-yet-linked GP (see src/common/gp-authorisation.client.ts).
# KNOWN GAP: not yet added to docker-compose.yml's "referral:" service block (out of
# services/referral's scope to edit that root-level file) — falls back to the
# gp-authorisation container's compose hostname/port below if unset.
GP_AUTHORISATION_SERVICE_URL="http://localhost:3003"
# Fail-open only if explicitly set to "true" — default is fail-closed (block referral
# creation) when the GP Authorisation Service can't be reached. See that client's doc comment.
GP_AUTHORISATION_FAIL_OPEN="false"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# Copy to .env for local development. Never commit a real .env — see root .gitignore.
# Full convention: root CONVENTIONS.md, "Environment variable conventions".

PORT=3008
NODE_ENV=development

# One Postgres instance, one schema per service (root CONVENTIONS.md, "Database access").
DATABASE_URL="postgresql://referralplatform:referralplatform@localhost:5432/referralplatform?schema=specialist_review"

# Keycloak (see docker-compose.yml "keycloak" service and infra/keycloak/realm-export.json)
KEYCLOAK_ISSUER="http://localhost:8180/realms/referralplatform"
KEYCLOAK_CLIENT_ID="specialist-review-service"
KEYCLOAK_CLIENT_SECRET="change-me-in-local-env"

# Audit Log Service (see packages/audit-client)
AUDIT_LOG_SERVICE_URL="http://localhost:3012"

# Redis (caching, rate limiting, session state — see docker-compose.yml "redis")
REDIS_URL="redis://localhost:6379"

# --- Specialist Review Service specific ---

# Which ExtractionProvider CasesService uses — "rule_based" (default, no external
# dependency) or "llm" (see src/extraction/llm-extraction.provider.ts — MOCK/fallback
# unless LLM_API_KEY is also set below).
EXTRACTION_PROVIDER="rule_based"

# Only read when EXTRACTION_PROVIDER=llm. Left unset here on purpose — no real LLM
# vendor credentials exist for this build; LlmExtractionProvider falls back to the
# rule-based provider (logged loudly) when this is unset. See that file's doc comment.
# LLM_API_KEY="change-me-in-local-env"
LLM_API_URL="https://api.openai.com/v1/chat/completions"
LLM_MODEL="gpt-4o-mini"

# Referral Service's base URL — used by ReferralServiceClient to best-effort sync
# branch decisions/completion back onto the referral's own state machine, forwarding
# the calling specialist's own bearer token (see src/common/referral-service.client.ts
# for why a service-to-service token can't be used for these specific endpoints).
REFERRAL_SERVICE_URL="http://referral:3005"
